# lawn: robots.txt tarpit + wall of shame.
# Installed to /etc/systemd/system/lawn.service by cloud-init and deploy/install.sh.
[Unit]
Description=lawn robots.txt tarpit and wall of shame
Documentation=https://getoffmyfuckinglawn.com/
Wants=network-online.target
After=network-online.target
# Cloud-init enables this unit before the first `make deploy` has shipped the
# binary; skip (rather than fail-loop) until it exists.
ConditionPathExists=/usr/local/bin/lawn
ConditionPathExists=/etc/lawn/config.yaml

[Service]
Type=simple
User=lawn
Group=lawn
WorkingDirectory=/opt/lawn
EnvironmentFile=/etc/lawn/env
# Soft heap target: the GC works harder before RSS nears the 500 MB budget
# (SPEC.md section 12) instead of letting garbage pile up under load.
Environment=GOMEMLIMIT=400MiB
ExecStart=/usr/local/bin/lawn serve -config /etc/lawn/config.yaml
# SIGHUP reloads the ASN table and the crawlers file.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s
KillSignal=SIGTERM

# Thousands of slow connections, each one a file descriptor.
LimitNOFILE=65536
# Load-test budget is < 500 MB RSS; hard-stop well before the box swaps.
MemoryHigh=900M
MemoryMax=1200M
TasksMax=4096

# Hardening. The service only needs to read its config/corpus, write
# /var/lib/lawn, and talk TCP/UDP (DNS for rDNS verification, HTTPS for vendor
# IP-range lists).
UMask=0027
NoNewPrivileges=yes
# Only the right to bind Gopher's port 70 (Gemini's 1965 needs nothing).
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ReadWritePaths=/var/lib/lawn
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Keep the cloud metadata service (which holds user-data, including the
# secret) out of reach of the process that faces hostile traffic.
IPAddressDeny=169.254.0.0/16

[Install]
WantedBy=multi-user.target
